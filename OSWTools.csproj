<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>OSWTools</RootNamespace>
    <AssemblyName>OSWTools</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <TargetFrameworkProfile />
    <ProjectGuid>{506F3823-40A9-0C9B-C4E7-B9AA4119907D}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <!-- We use no NuGet packages — all references are direct HintPath DLLs.    -->
    <!-- Disabling NuGet resolution prevents Microsoft.NuGet.targets from        -->
    <!-- running the ResolveNuGetPackageAssets target which requires             -->
    <!-- TargetFrameworks (plural) in newer NuGet versions.                      -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <RestoreProjectStyle>PackagesConfig</RestoreProjectStyle>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- ── Local DLL references ──────────────────────────────────────────────────
       These two Streamer.bot assemblies live in the dlls/ subfolder.
       Copy them from your Streamer.bot installation folder whenever SB updates.
       They are NOT redistributed — .gitignore the dlls/ folder or add a note
       in the README so contributors know where to source them.
  ──────────────────────────────────────────────────────────────────────────── -->
  <ItemGroup>
    <Reference Include="Streamer.bot.Plugin.Interface">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>dlls\Streamer.bot.Plugin.Interface.dll</HintPath>
    </Reference>
    <Reference Include="Streamer.bot.Common">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>dlls\Streamer.bot.Common.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- ── Framework references ──────────────────────────────────────────────────
       Standard .NET 4.8.1 framework assemblies.
       System.Windows.Forms and System.Drawing give us WinForms support
       without needing any NuGet packages.
  ──────────────────────────────────────────────────────────────────────────── -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <!-- ── Source files ───────────────────────────────────────────────────────────
       The root OSWLib.cs defines the partial class and constructor.
       Everything else extends it via partial class in subfolders.
  ──────────────────────────────────────────────────────────────────────────── -->
  <ItemGroup>
    <Compile Include="OSWLib.cs" />
    <Compile Include="BotEliminator\**\*.cs" />
    <Compile Include="Theme\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Data\**\*.cs" />
    <Compile Include="Utilities\**\*.cs" />
    <Compile Include="Extensions\**\*.cs" />
    <Compile Include="Versioning\**\*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>