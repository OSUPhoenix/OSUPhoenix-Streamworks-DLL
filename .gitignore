## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##

# ── Build results ────────────────────────────────────────────────────────────
bin/
obj/

# ── Streamer.bot / OSWTools DLLs ─────────────────────────────────────────────
# These must be copied from your local Streamer.bot installation.
# They are not redistributable and must not be committed to the repo.
# See README.md for instructions on where to find them.
dlls/

# ── Visual Studio ─────────────────────────────────────────────────────────────
# IDE cache and settings
.vs/

# User-specific project settings
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider (JetBrains) IDE
.idea/
*.sln.iml

# ── NuGet ────────────────────────────────────────────────────────────────────
# NuGet package restore cache (restored automatically on build)
packages/
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/

# ── OS generated ─────────────────────────────────────────────────────────────
# Windows
Thumbs.db
Desktop.ini

# macOS (if any contributors use it)
.DS_Store
.AppleDouble

# ── Logs and temp files ───────────────────────────────────────────────────────
*.log
*.tmp
*.temp

# ── Personal Use with Private Data───────────────────────────────────────────────────────────────────
Personal References/

# ── OMS credential files ─────────────────────────────────────────────────────
# OmsCredentials.cs contains the real Google OAuth Client ID, Client Secret,
# and DPAPI entropy bytes. NEVER commit this file.
# The template (OmsCredentials.template.cs) is committed instead.
OSWTools/Scheduling/OmsCredentials.cs

# OmsCredentialBuilder.cs may have real credentials pasted in while running.
# Exclude it from release builds via build configuration, but also exclude from
# accidental commits if it ever has real values in it.
# Comment this line out if you want the tool itself in the repo (with empty strings).
OSWTools/Scheduling/OmsCredentialBuilder.cs
